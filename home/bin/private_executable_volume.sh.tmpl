#!/usr/bin/env sh

set -o errexit

vol_up() {
  amixer -D hw:{{ .sound_card }} sset Master 1%+
  vol_get
}

vol_down() {
  amixer -D hw:{{ .sound_card }} sset Master 1%-
  vol_get
}

vol_set() {
  amixer -D hw:{{ .sound_card }} sset Master "$1"%
  vol_get
}

vol_get() {
  vol=$(amixer -D hw:{{ .sound_card }} sget Master | grep -o "[0-9]*%" | head -n 1)
  echo "$vol"
}

case "$1" in
  up)
    vol_up
    shift
    ;;
  down)
    vol_down
    shift
    ;;
  set)
    vol_set "$2"
    shift
    shift
    ;;
  get)
    vol_get
    shift
    ;;
  *)
    echo "call $0 with only [up] or [down]"
    exit 1
  ;;
esac
